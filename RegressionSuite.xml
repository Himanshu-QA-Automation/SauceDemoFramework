<?xml version="1.0" encoding="UTF-8"?>



<suite name="SauceDemoRegressionSuite">

    <listeners>
        <listener class-name="TestListeners.TestListener"/>
    </listeners>

    <test name="Chrome Regression Tests">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
            <class name="com.saucedemo.tests.InventoryTests"/>
            <class name="com.saucedemo.tests.CartPageTest"/>
            <class name="com.saucedemo.tests.CheckOutFlowTest"/>
        </classes>

    </test>

</suite>