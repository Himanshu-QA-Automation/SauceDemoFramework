<?xml version="1.0" encoding="UTF-8"?>

<suite name="SauceDemoSmokeSuite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="TestListeners.TestListener"/>
    </listeners>

    <!-- Chrome -->
    <test name="Chrome Smoke Tests">

        <parameter name="browser" value="chrome"/>

        <classes>

            <class name="com.saucedemo.tests.LoginTest">
                <methods>
                    <include name="verifyValidLogin"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.InventoryTests">
                <methods>
                    <include name="verifyInventoryPageAndAddToCart"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.CartPageTest">
                <methods>
                    <include name="verifyCartPageFlow"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.CheckOutFlowTest">
                <methods>
                    <include name="verifyCheckOutFlowTest"/>
                </methods>
            </class>

        </classes>
    </test>


    <!-- Edge -->
    <test name="Edge Smoke Tests">

        <parameter name="browser" value="edge"/>

        <classes>

            <class name="com.saucedemo.tests.LoginTest">
                <methods>
                    <include name="verifyValidLogin"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.InventoryTests">
                <methods>
                    <include name="verifyInventoryPageAndAddToCart"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.CartPageTest">
                <methods>
                    <include name="verifyCartPageFlow"/>
                </methods>
            </class>

            <class name="com.saucedemo.tests.CheckOutFlowTest">
                <methods>
                    <include name="verifyCheckOutFlowTest"/>
                </methods>
            </class>

        </classes>
    </test>

</suite>